// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Using the unpooled connection here too — the pooled endpoint
  // (DATABASE_URL, through PgBouncer) was unreachable at runtime
  // (PrismaClientInitializationError: "Can't reach database server").
  // The unpooled endpoint is confirmed working (migrate deploy uses it
  // via DIRECT_URL successfully).
  url       = env("DATABASE_URL_UNPOOLED")
  // Migrations need a direct (non-pooled) connection — Neon's pooled URL
  // goes through PgBouncer, which doesn't support the session-level advisory
  // lock `prisma migrate deploy` takes, and times out with error P1002.
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  IDEA
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  TWITTER
  LINKEDIN
  FACEBOOK
  OTHER
}

enum NotificationKind {
  CONTENT_SAVED
  CONTENT_SCHEDULED
  SCHEDULE_REMINDER
  DAILY_DIGEST
  METRICS_REMINDER
}

enum Plan {
  FREE
  PRO
  STUDIO
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  timeZone     String   @default("Asia/Jakarta")

  /// Minutes before a scheduled slot to fire the reminder push.
  reminderLeadMinutes Int     @default(60)
  dailyDigestEnabled  Boolean @default(true)
  /// Hour of day (0-23, in the user's time zone) to send the daily digest.
  dailyDigestHour     Int     @default(7)

  plan          Plan      @default(FREE)
  /// When the current paid period ends; null while on the free plan.
  planRenewsAt  DateTime?
  aiQuotaUsed   Int       @default(0)
  /// When aiQuotaUsed rolls back to 0. Reset lazily the next time quota is checked.
  aiQuotaResetAt DateTime?

  accounts      SocialAccount[]
  contentItems  ContentItem[]
  subscriptions PushSubscription[]
  notifications Notification[]
  aiThreads     AiThread[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One billing attempt/transaction for a plan upgrade, created before redirecting
/// the user to the payment gateway and confirmed once the webhook (or a manual
/// re-check) reports it paid.
model Order {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan
  amount   Int
  status   OrderStatus @default(PENDING)
  provider String      @default("lynk")
  /// Invoice/transaction id from the payment gateway, set once the checkout is created.
  externalId   String? @unique
  paymentLink  String?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SocialAccount {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  handle   String?
  platform Platform
  /// Hex colour used to tint this account across calendar and board views.
  color    String   @default("#6366f1")
  archived Boolean  @default(false)

  contentItems ContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ContentItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  title       String
  hook        String?
  description String?
  platform    Platform
  contentType String
  status      ContentStatus @default(IDEA)
  tags        String[]      @default([])

  scheduledAt DateTime?
  publishedAt DateTime?
  postUrl     String?
  notes       String?

  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  saves      Int?
  hoursSpent Float?
  revenue    Float?

  /// Set once the pre-publish reminder push has gone out, so it only fires once.
  reminderSentAt DateTime?

  checklist ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([accountId])
}

model ChecklistItem {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean     @default(false)
  position  Int         @default(0)

  createdAt DateTime @default(now())

  @@index([contentId])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind
  title  String
  body   String
  href   String?
  read   Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Server-side secrets (session signing key, VAPID key pair) generated on first
/// use so the app works without any manual environment variable setup.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

enum AiRole {
  USER
  ASSISTANT
}

/// A saved conversation with the AI assistant.
model AiThread {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String

  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model AiMessage {
  id       String   @id @default(cuid())
  threadId String
  thread   AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role     AiRole
  content  String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}
