# Postgres connection string. On Vercel, connect a Postgres database from the
# "Storage" tab of your project and this is set automatically.
# For local development, use any Postgres instance (e.g. a free Neon database)
# and paste its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional — enables the AI assistant. Create one at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional — enables paid plans (Pro/Studio) via Mayar. Without this, AI stays
# unlimited for every account and the upgrade buttons are hidden.
# MAYAR_API_KEY="..."
# Shared secret you choose yourself and paste into both here and the webhook
# URL configured in the Mayar dashboard: /api/billing/webhook/mayar?token=...
# MAYAR_WEBHOOK_TOKEN="..."

# Optional — enables manual transfer (e.g. GoPay) as a way to upgrade, with the
# operator confirming payments by hand at /admin/orders. Useful before Mayar
# (or any gateway) is fully verified and ready.
# MANUAL_PAYMENT_GOPAY_NUMBER="08xxxxxxxxxx"

# Required to use /admin/orders — must match the email of the account that's
# allowed to confirm manual payments (i.e. your own login email).
# ADMIN_EMAIL="you@example.com"
