# Postgres connection string. On Vercel, connect a Postgres database from the
# "Storage" tab of your project and this is set automatically.
# For local development, use any Postgres instance (e.g. a free Neon database)
# and paste its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection, required for migrations — Prisma's migrate
# command can't run through a connection pooler like Neon's PgBouncer. On
# Vercel with the Neon integration, use the "_UNPOOLED" / "NON_POOLING"
# connection string it generates (see README). Locally, just copy DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional — enables the AI assistant. Either key works; the gateway wins when
# both are set.
#
# Vercel AI Gateway reaches Gemini, Claude and others through one key, with a
# free monthly credit. Grab it from the AI Gateway tab of your Vercel project.
# AI_GATEWAY_API_KEY="..."
#
# Or talk to Anthropic directly: https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional — which model to use. Defaults to google/gemini-2.5-flash on the
# gateway, or claude-sonnet-5 when calling Anthropic directly. Swap this for
# anthropic/claude-sonnet-5 to move up once the cheaper model isn't enough.
# Gateway model ids are listed at https://ai-gateway.vercel.sh/v1/models
# AI_MODEL="google/gemini-2.5-flash"

# Optional override for the account allowed to open /admin/plans. The current
# production owner defaults to beny.fajriansyah@gmail.com.
# ADMIN_EMAIL="beny.fajriansyah@gmail.com"

# Optional override for the public OrderHero checkout URL. Production defaults
# to https://famzcoffee.orderhero.id/form/creator-pro.
# Never put an API key or private token here.
# NEXT_PUBLIC_ORDERHERO_CHECKOUT_URL="https://..."

# Required in production. Vercel sends this value automatically as a Bearer
# token when invoking the configured cron endpoint.
# CRON_SECRET="generate-a-long-random-value"

# Optional support number used by the payment-confirmation WhatsApp button.
# Digits only, with country code and without a leading +.
# NEXT_PUBLIC_SUPPORT_WHATSAPP="62895323408858"

# Optional — lets people reset their own password by email, via Resend
# (https://resend.com). Without it the reset flow still works, but the link has
# to be generated by the operator at /admin/plans and handed over manually.
# RESEND_API_KEY="re_..."
# Sender address. Resend's shared onboarding@resend.dev works for testing;
# a verified domain of your own is needed before mail reliably reaches inboxes.
# EMAIL_FROM="Creator Studio <halo@domainmu.com>"
